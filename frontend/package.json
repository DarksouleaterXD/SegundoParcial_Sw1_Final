{
  "name": "classforge-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "astro dev",
    "build": "astro build",
    "test:generation": "node --experimental-strip-types --test src/app/projects/generation/spring-boot-generation.utils.test.ts",
    "test:commands": "node --experimental-transform-types --experimental-loader ./scripts/ts-extension-loader.mjs --test src/app/projects/commands/uml-command-characterization.test.ts",
    "test:characterization": "npm run test:generation && npm run test:commands && npm run test:workspace",
    "test:workspace": "node --experimental-transform-types --experimental-loader ./scripts/ts-extension-loader.mjs --test src/app/projects/state/workspace/workspace-state-characterization.test.ts",
    "preview": "astro preview",
    "check": "astro check && vue-tsc --noEmit"
  },
  "engines": {
    "node": ">=22.22.3"
  },
  "dependencies": {
    "@joint/core": "4.3.2",
    "@stomp/stompjs": "7.3.0",
    "material-symbols": "0.47.0",
    "rxjs": "~7.8.2",
    "astro": "^6.4.8",
    "@astrojs/vue": "^6.0.0",
    "@vue/reactivity": "^3.5.24",
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "sass": "^1.93.0",
    "typescript": "~5.9.3",
    "vue-tsc": "^3.2.0"
  },
  "overrides": {
    "vite": "^7.3.2"
  }
}
