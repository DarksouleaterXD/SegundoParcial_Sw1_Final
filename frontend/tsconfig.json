{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "target": "ES2022",
    "verbatimModuleSyntax": false,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true
  },
  "include": [".astro/types.d.ts", "src/**/*"],
  "exclude": ["dist", "**/*.test.ts"]
}
